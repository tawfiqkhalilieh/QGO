package main

// Iterative sum from 1 to n.
func sumToN(n: int) -> int {
    total := 0
    for i := 1; i <= n; i = i + 1 {
        total = total + i
    }
    return total
}

// Closed-form Gauss formula: n * (n + 1) / 2.
func sumToNGauss(n: int) -> int {
    return n * (n + 1) / 2
}

func TestSumToN() {
    assert_eq(sumToN(0), 0)
    assert_eq(sumToN(1), 1)
    assert_eq(sumToN(10), 55)
    assert_eq(sumToN(100), 5050)
    assert_eq(sumToNGauss(100), 5050)
}

func main() {
    println("sumToN(10)  =", sumToN(10))
    println("sumToN(100) =", sumToN(100))
    println("gauss(100)  =", sumToNGauss(100))
}
