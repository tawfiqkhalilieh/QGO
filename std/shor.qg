package shor

// Reversible Fredkin (Controlled-SWAP) gate decomposed into CX + CCX + CX.
func CSwap(c qubit, a qubit, b qubit) qfree {
    CX(b, a)
    CCX(c, a, b)
    CX(b, a)
}

// Controlled modular multiplication by 4 mod 15: |y> -> |(4 * y) mod 15>
// Multiplying a 4-bit binary number by 4 mod 15 is a 2-bit cyclic shift (swapping bit0<->bit2, bit1<->bit3).
func CtrlMul4Mod15(c qubit, work qreg[4]) qfree {
    CSwap(c, work[0], work[2])
    CSwap(c, work[1], work[3])
}

// Controlled modular multiplication by 7 mod 15: |y> -> |(7 * y) mod 15>.
func CtrlMul7Mod15(c qubit, work qreg[4]) qfree {
    CSwap(c, work[2], work[3])
    CSwap(c, work[1], work[2])
    CSwap(c, work[0], work[1])
    ctrl(c) X(work[0])
    ctrl(c) X(work[1])
    ctrl(c) X(work[2])
    ctrl(c) X(work[3])
}

// In-place 3-qubit Quantum Fourier Transform in little-endian basis (reg[0] = LSB).
func QFT3(reg qreg[3]) unitary {
    H(reg[2])
    CP(1.5707963267948966, reg[1], reg[2])
    CP(0.7853981633974483, reg[0], reg[2])

    H(reg[1])
    CP(1.5707963267948966, reg[0], reg[1])

    H(reg[0])

    Swap(reg[0], reg[2])
}

// Shor's Quantum Order-Finding Subroutine for factoring N = 15 with base a = 7.
// Since 7^4 = 2401 = 160 * 15 + 1 === 1 (mod 15), the multiplicative order is r = 4.
func ShorOrderFinding15(phase qreg[3], work qreg[4]) unitary {
    // Initialize work register to |0001> = |1>
    X(work[0])

    // Uniform superposition over 3-bit exponent x = x_0 + 2*x_1 + 4*x_2
    H(phase[:])

    // Apply 7^(2^0) mod 15 = 7 mod 15 controlled on phase[0]
    CtrlMul7Mod15(phase[0], work)

    // Apply 7^(2^1) mod 15 = 49 mod 15 = 4 mod 15 controlled on phase[1]
    CtrlMul4Mod15(phase[1], work)

    // 7^(2^2) mod 15 = 7^4 mod 15 = 1 mod 15 is the identity on phase[2]

    // Inverse QFT on phase register to extract peaks at multiples of 2^3 / r = 8 / 4 = 2
    adj QFT3(phase)
}

func GCD(a int, b int) -> int {
    x := a
    y := b
    for y != 0 {
        rem := x % y
        x = y
        y = rem
    }
    return x
}

func TestShorFactor15() {
    phase := qalloc[3]()
    work := qalloc[4]()
    ShorOrderFinding15(phase, work)

    // Period r = 4 divides 2^3 = 8, so all probability weight lies on even states {0, 2, 4, 6}
    // while odd states {1, 3, 5, 7} have zero probability.
    p_odd := prob_basis(phase, 1) + prob_basis(phase, 3) + prob_basis(phase, 5) + prob_basis(phase, 7)
    assert(p_odd < 0.000000001)

    p_even := prob_basis(phase, 0) + prob_basis(phase, 2) + prob_basis(phase, 4) + prob_basis(phase, 6)
    assert(p_even > 0.999999999)

    // Classical post-processing with extracted order r = 4 and base a = 7:
    // a^(r/2) = 7^2 = 49. Factors are gcd(49 - 1, 15) = 3 and gcd(49 + 1, 15) = 5.
    f1 := GCD(49 - 1, 15)
    f2 := GCD(49 + 1, 15)
    assert_eq(f1, 3)
    assert_eq(f2, 5)
    assert_eq(f1 * f2, 15)
}
